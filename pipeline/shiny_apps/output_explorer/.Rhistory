all_gs<-tx_drug_summary_data_filtered()
all_gs$Method<-factor(all_gs$Method, levels=c('MAGMA','GCSC','TWAS-GSEA'))
# Now remove the NA rows
all_gs<-all_gs[!is.na(all_gs$Name),]
group_siz<-NULL
for(i in c('MAGMA','GCSC','TWAS-GSEA')){
group_siz<-rbind(group_siz, data.frame(Group=i,
Size=length(unique(all_gs$Panel[all_gs$Method==i]))))
}
# Set minimum size to 3 to allow space for labels
group_siz$Size[group_siz$Size < 2]<-2
group_siz$Prop<-group_siz$Size/sum(group_siz$Size)
group_siz$Width<-4*group_siz$Prop
x<-c(-max(abs(all_gs$Z), na.rm=T),0,max(abs(all_gs$Z), na.rm=T))
x<-(x-min(x))/(max(x)-min(x))
heatmap<-ggplot(data = all_gs, aes(x = Panel, y = Name)) +
theme_bw()	+
geom_point(data=all_gs[all_gs$P < 0.05,], aes(x = Panel, y = Name), colour='black', fill=NA, size=6) +
geom_point(data=all_gs[all_gs$P.FDR < 0.05,], aes(x = Panel, y = Name), colour='black', fill=NA, size=7, shape=15) +
geom_point(data=all_gs, aes(colour = Z), size=5) +
scale_colour_gradientn(colours=c("#0066FF","#0099FF","#FFFFFF","#FF6666","#FF0000"), na.value = NA,name = "Z-score", limits = c(-max(abs(all_gs$Z), na.rm=T), max(abs(all_gs$Z), na.rm=T)), values=x) +
theme(axis.text.x = element_text(angle = 45, hjust = 1),plot.title = element_text(hjust = 0.5)) +
labs(x='', y='') +
facet_wrap(~ Method , nrow=1, scales = "free_x")
library(grid)
gt = ggplot_gtable(ggplot_build(heatmap))
for(i in 1:nrow(group_siz)){
gt$widths[gt$layout$l[grep(paste0('panel-',i,'-1'), gt$layout$name)]] = group_siz$Width[i]*gt$widths[gt$layout$l[grep(paste0('panel-',i,'-1'), gt$layout$name)]]
}
heatmap
all_gs
