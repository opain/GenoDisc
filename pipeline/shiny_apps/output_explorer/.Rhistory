num_col <- length(unique(paste0(all_gs$Panel,'_',all_gs$Method,'_')))
plot_width<-(max(nchar(all_gs$Name), na.rm=T)*1.2)+(num_col * 60)
plot_width<-max(plot_width,(length(unique(all_gs$Method))*100))
